<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Book Notes</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<main class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Reading journal</p>
            <h1>My Book Notes</h1>
        </div>
        <a class="button button--gold" href="/add">Add a book</a>
    </header>

    <!-- Sorting Filter Controller Form -->
    <div class="sort-bar">
        <form action="/" method="GET">
            <select name="sort" onchange="this.form.submit()">
                <option value="recency" <%= currentSort === 'recency' ? 'selected' : '' %>>Sort by Recency</option>
                <option value="rating" <%= currentSort === 'rating' ? 'selected' : '' %>>Sort by Rating</option>
                <option value="title" <%= currentSort === 'title' ? 'selected' : '' %>>Sort by Title</option>
            </select>
        </form>
    </div>

    <!-- Master Book Collection Loop Matrix -->
    <% if (books && books.length > 0) { %>
        <div class="book-grid">
        <% books.forEach(book => { %>
            <article class="book-card">
                
                <!-- Dynamic Open Library Cover Art Endpoint Integration Matrix -->
                 <img src="<%= book.cover_url || `https://covers.openlibrary.org/isbn/${book.isbn}-M.jpg?default=false` %>" 
                     alt="Cover for <%= book.title %>"
                     loading="lazy"
                     onerror="this.onerror=null; this.src='https://placehold.co/600x800?text=<%= encodeURIComponent(book.title) %>'">
                
                <!-- Core Stored PostgreSQL Variables Data Ingestion Blocks -->
                <div class="book-card__content">
                    <h2><%= book.title %></h2>
                    <p>Author: <%= book.author %></p>
                    <p>Rating: <%= book.rating %>/10</p>
                    <p>Date Read: <%= new Date(book.date_read).toLocaleDateString() %></p>
                    <p><%= book.notes %></p>

                    <!-- Database DELETE Action Trigger -->
                    <form action="/books/<%= book.id %>/delete" method="POST">
                        <button type="submit" onclick="return confirm('Delete entry?')">Delete</button>
                    </form>
                </div>

            </article>
        <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <p>No books have been added yet.</p>
            <a class="button" href="/add">Add your first book</a>
        </div>
    <% } %>
</main>
</body>
</html>
